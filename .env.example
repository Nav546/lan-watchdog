# Copy to .env. All optional.
# Discord, Slack, Teams (Workflows) or any webhook that accepts {"text": "..."} / {"content": "..."}
ALERT_WEBHOOK_URL=
# Don't repeat the same alert (same kind + same source) within this many seconds
ALERT_COOLDOWN_SECONDS=300
# How often to ARP-scan the LAN
SCAN_INTERVAL_SECONDS=120
# Set if the scan picks the wrong network card, e.g. eth0 or wlp2s0
SCAN_INTERFACE=
DASHBOARD_PORT=8088
